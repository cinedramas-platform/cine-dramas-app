# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Mux
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_SIGNING_KEY_ID=your-signing-key-id
MUX_SIGNING_PRIVATE_KEY=your-signing-private-key
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# RevenueCat
REVENUECAT_API_KEY=your-public-api-key
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# Sentry
# Runtime DSN lives per-brand in brands/<variant>/manifest.json (sentryDsn).
# The two below are build-time only — used by the Sentry Expo plugin in CI to
# upload source maps. Leave unset locally; source-map upload is then skipped.
SENTRY_ORG=your-sentry-org
SENTRY_AUTH_TOKEN=your-build-time-auth-token

# App
APP_VARIANT=default
