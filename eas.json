{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "default"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "default"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "default"
      }
    },

    "clientA-development": {
      "extends": "development",
      "channel": "clienta-development",
      "env": {
        "APP_VARIANT": "clientA"
      }
    },
    "clientA-preview": {
      "extends": "preview",
      "channel": "clienta-preview",
      "env": {
        "APP_VARIANT": "clientA"
      }
    },
    "clientA-production": {
      "extends": "production",
      "channel": "clienta-production",
      "env": {
        "APP_VARIANT": "clientA"
      }
    }
  },
  "submit": {
    "production": {},
    "clientA-production": {}
  }
}
